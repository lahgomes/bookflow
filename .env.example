PORT=3000
NODE_ENV=development

# MongoDB — docker compose usa root:root@localhost
MONGODB_URI=mongodb://root:root@localhost:27017/reading-service?authSource=admin

# RabbitMQ — docker compose usa guest:guest@localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT — troque por uma string longa e aleatória em produção
JWT_SECRET=super-secret-jwt-key-change-this-in-production

# Google Books API — obtenha sua chave em https://developers.google.com/books
# Deixe vazio para usar a API pública (limitada)
GOOGLE_BOOKS_API_KEY=

# CORS — origem permitida para o frontend
CORS_ORIGIN=http://localhost:3001
